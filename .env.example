# 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
# 공공데이터포털 "일반 인증키 (Decoding)"
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=
# (선택) Claude 크레딧이 떨어지거나 오류가 나면 Gemini 가 대신 답합니다. Google AI Studio 에서 발급
GEMINI_API_KEY=
# (선택) 쓸 Gemini 모델. 비우면 gemini-2.5-flash, 없으면 gemini-2.0-flash 로 넘어갑니다
GEMINI_MODEL=
